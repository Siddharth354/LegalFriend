# backend/.env.example — documents every variable the backend reads.
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Required — Sarvam AI API key (STT, translation, chat, TTS).
SARVAM_API_KEY=your-key-here

# Optional — defaults shown. Override only if you need something different.
ENV=dev
DENSE_MODEL_NAME=zeroentropy/zembed-1
DENSE_MODEL_DTYPE=bfloat16
SPARSE_MODEL_NAME=Qdrant/bm25
COLLECTION_NAME=legal_acts
RETRIEVAL_TOP_K=5
DEMO_MODE=false

# JSON array of extra allowed CORS origins, e.g. for testing from another
# device on the LAN: CORS_EXTRA_ORIGINS=["http://192.168.1.20:3000"]
CORS_EXTRA_ORIGINS=[]
